---
import Component from "../components/Component.astro";
import Experience from "../components/experience/index.astro";
import Projects from "../components/projects/index.astro";
import GalleryModal from "../components/projects/gallery-modal.astro";
import { EXPERIENCE } from "../data/experience";
import { PROJECTS } from "../data/projects";
import { SOCIALS } from "../data/socials";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Ali Raza | Software Engineer">
  <div class="relative hero z-10">
    <div
      class="mx-auto min-h-screen max-w-screen-2xl px-6 py-12 font-sans md:px-12 md:py-20 lg:px-24 lg:py-0"
    >
      <div class="lg:flex lg:justify-between lg:gap-4">
        <header
          class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[45%] lg:flex-col lg:justify-between lg:py-24"
        >
          <div
            class="flex flex-col items-center text-center lg:items-start lg:text-left gap-6"
          >
            <img
              src="/avatar.png"
              alt="Ali Raza"
              class="rounded-full w-24 h-24 lg:w-28 lg:h-28 object-cover border border-neutral-700/30 shadow-lg"
            />
            <div class="flex flex-col items-center lg:items-start">
              <a
                href="/"
                class="text-4xl lg:text-5xl block font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-b from-neutral-50 to-neutral-400 bg-opacity-50"
              >
                <h1>Ali Raza</h1>
              </a>
              <h2 class="mt-2 text-sm lg:text-lg font-medium text-neutral-400">
                Software Engineer
              </h2>
              <div class="flex flex-col md:flex-row items-center gap-6 md:gap-4 mt-4">
                <a
                  data-ccursor
                  href="mailto:aliwebdev3986@proton.me"
                  class="inline-flex items-center gap-x-2.5 rounded-full border border-white/10 bg-gradient-to-b from-neutral-800/80 to-neutral-900/90 px-5 py-2 text-sm font-semibold text-white shadow-[0_0_20px_rgba(255,255,255,0.08)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:from-neutral-700/80 hover:to-neutral-800/90 hover:border-white/20 hover:shadow-[0_0_25px_rgba(255,255,255,0.12)] group w-fit"
                >
                  <span>Say Hello</span>
                  <span
                    class="inline-block transition-transform duration-300 group-hover:rotate-12 group-hover:scale-110"
                    >👋</span
                  >
                </a>

                <a
                  data-ccursor
                  class="inline-flex items-center leading-tight text-neutral-300 hover:text-white font-semibold group py-2 px-3 rounded-full"
                  aria-label="View Résumé"
                  target="_blank"
                  rel="noreferrer noopener"
                  href="https://upwork.com/freelancers/aliraza5490"
                >
                  <span>
                    <span class="whitespace-nowrap">
                      <span
                        class="border-b border-transparent pb-px transition group-hover:border-neutral-300 motion-reduce:transition-none"
                      >
                        Hire Me!
                      </span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="ml-1 inline-block h-4 w-4 shrink-0 -translate-y-px transition-transform group-hover:translate-x-2 group-focus-visible:translate-x-2 motion-reduce:transition-none"
                        aria-hidden="true"
                        ><path
                          fill-rule="evenodd"
                          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                          clip-rule="evenodd"></path></svg
                      ></span
                    ></span
                  ></a
                >
              </div>
            </div>
          </div>

          {
            SOCIALS.length && (
              <ul
                class="mt-8 flex items-center justify-center lg:justify-normal gap-x-5"
                aria-label="Social media"
              >
                {SOCIALS.map((social) => (
                  <li class="text-xs p-2 rounded" data-ccursor>
                    <a
                      class="block hover:text-slate-200"
                      href={social.url}
                      target="_blank"
                      rel="noreferrer noopener"
                      aria-label={`${social.name} (opens in a new tab)`}
                    >
                      <span class="sr-only">{social.name}</span>
                      {<Component component={social.icon} />}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <main id="content" class="pt-24 lg:w-[55%] lg:py-24">
          <section
            id="about"
            class="mb-10 scroll-mt-16 md:mb-16 lg:mb-20 lg:scroll-mt-24"
            aria-label="About me"
          >
            <div
              class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
            >
              <h2
                class="text-sm font-bold uppercase tracking-widest text-neutral-200 lg:sr-only"
              >
                About
              </h2>
            </div>
            <div>
              <div class="mb-4 space-y-4">
                <p>
                  I build AI-powered software, automation systems, and scalable
                  web applications focused on performance, reliability, and
                  great user experience.
                </p>

                <p>
                  Looking forward to new challenges and exciting collaborations!
                </p>
              </div>
            </div>
          </section>
          <section
            id="experience"
            class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
            aria-label="Work experience"
          >
            <div
              class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:mb-8"
            >
              <h2
                class="text-sm font-bold uppercase tracking-widest text-neutral-200"
              >
                Experience
              </h2>
            </div><div>
              <ol class="group/list">
                {EXPERIENCE.map((experience, index) => <Experience {...experience} isLast={index === EXPERIENCE.length - 1} />)}
              </ol>
            </div>
          </section>
          <section
            id="projects"
            class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
            aria-label="Selected projects"
          >
            <div
              class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:mb-8"
            >
              <h2
                class="text-sm font-bold uppercase tracking-widest text-neutral-200"
              >
                Projects
              </h2>
            </div>
            <div>
              <ul class="group/list">
                {PROJECTS.map((project) => <Projects {...project} />)}
              </ul>
            </div>
          </section>
          <footer
            class="max-w-md pb-16 text-xs text-neutral-500 sm:pb-0 leading-relaxed"
          >
            <p>
              Designed in
              <a
                href="https://www.figma.com/"
                class="font-medium text-neutral-400 hover:text-red-300 focus-visible:text-red-300 transition-colors"
                target="_blank"
                rel="noreferrer">Figma</a
              >
              · Built with
              <a
                href="https://astro.build/"
                class="font-medium text-neutral-400 hover:text-red-300 focus-visible:text-red-300 transition-colors"
                target="_blank"
                rel="noreferrer">Astro</a
              >,
              <a
                href="https://react.dev/"
                class="font-medium text-neutral-400 hover:text-red-300 focus-visible:text-red-300 transition-colors"
                target="_blank"
                rel="noreferrer">React</a
              >,
              <a
                href="https://tailwindcss.com/"
                class="font-medium text-neutral-400 hover:text-red-300 focus-visible:text-red-300 transition-colors"
                target="_blank"
                rel="noreferrer">Tailwind CSS</a
              >, and
              <a
                href="https://www.typescriptlang.org/"
                class="font-medium text-neutral-400 hover:text-red-300 focus-visible:text-red-300 transition-colors"
                target="_blank"
                rel="noreferrer">TypeScript</a
              >.
            </p>
            <p class="mt-4">
              {new Date().getFullYear()} All rights reserved.
            </p>
          </footer>
        </main>
      </div>
    </div>
  </div>
  <GalleryModal />
</Layout>

<style scoped>
  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .hero {
    background-image: url(/pattern.svg);
    background-position: top;
    background-repeat: no-repeat;
    background-size: 100% auto;
    overflow-y: visible;
    overflow-x: clip;
  }

  @media (min-width: 1024px) {
    .hero {
      background-size: auto;
    }
  }

  /*
  .hero {
    animation: fadeIn 3s;
  }
   */
</style>
