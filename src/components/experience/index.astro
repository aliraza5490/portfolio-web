---
import type { Props } from "./props";
import IconArrow from "../icons/arrow.astro";

const { dates, title, company, companyUrl, description, technologies, logo, isLast = false } =
  Astro.props;
---

<li class="relative pb-12 last:pb-0">
  <div
    class="group relative flex flex-col transition-all lg:hover:!opacity-100 lg:group-hover/list:opacity-50 hover:backdrop-blur-sm duration-500"
  >
    <div
      class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-neutral-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"
    >
    </div>

    <!-- Date Header & Horizontal Line & Dot -->
    <header
      class="z-10 relative mb-6 mt-1 text-[10px] font-semibold uppercase tracking-wide text-neutral-500 w-fit pl-8"
      aria-label={dates}
    >
      <span>{dates}</span>
      <!-- Horizontal line: matches date length -->
      <div class="absolute left-3 right-0 bottom-[-8px] h-[1.5px] bg-neutral-800 group-hover:bg-neutral-700/80 transition-colors duration-300"></div>
      <!-- Junction node (dot) -->
      <div class="absolute left-3 -translate-x-1/2 bottom-[-11px] w-[7px] h-[7px] rounded-full border border-neutral-600 bg-neutral-950 z-20 group-hover:border-neutral-400 group-hover:bg-neutral-100 transition-all duration-300 shadow-[0_0_0_4px_rgba(0,0,0,1)]"></div>
    </header>

    <!-- Vertical line (relative to li container to span correctly across items) -->
    {
      !isLast && (
        <div class="absolute left-3 -translate-x-1/2 top-[33px] bottom-[-25px] w-[1.5px] bg-neutral-800 group-hover:bg-neutral-700/80 transition-colors duration-300 z-10 timeline-line" />
      )
    }

    <!-- Content details -->
    <div class="z-10 pl-8 mt-3">
      <h3 class="font-medium leading-snug text-neutral-200">
        <div>
          <a
            class="inline-flex items-baseline font-medium leading-tight text-neutral-200 hover:text-neutral-300 focus-visible:text-neutral-300 group/link text-base"
            href={companyUrl}
            target="_blank"
            rel="noreferrer"
            aria-label={title}
          >
            <span
              class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"
            ></span>
            <div class="flex gap-x-2 items-center">
              {
                logo && (
                  <img
                    class="w-8 h-8 rounded bg-neutral-400/10 "
                    src={logo}
                    alt={`${company} logo`}
                  />
                )
              }
              <span
                >{title} ·
                <span class="inline-block">
                  {company}
                  <IconArrow />
                </span>
              </span>
            </div>
          </a>
        </div>
      </h3>
      {
        description.includes("\n") ? (
          <ul class="mt-2 text-sm leading-normal list-disc pl-4 space-y-2">
            {description.split("\n").map((line) => {
              const cleaned = line.trim().replace(/^-\s*/, "");
              return cleaned ? <li>{cleaned}</li> : null;
            })}
          </ul>
        ) : (
          <p class="mt-2 text-sm leading-normal">{description}</p>
        )
      }
      {
        technologies.length && (
          <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
            {technologies.map((technology) => (
              <li class="mr-1.5 mt-2">
                <div class="flex items-center backdrop-blur-sm rounded-full border border-neutral-700 border-opacity-50 shadow bg-neutral-400/10 px-3 py-1 text-xs font-medium leading-5 text-neutral-300">
                  {technology}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</li>
